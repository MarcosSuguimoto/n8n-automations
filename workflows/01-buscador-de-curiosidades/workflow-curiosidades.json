    {
      "parameters": {
        "jsCode": "// Pega o texto enviado pelo usuário no Chat Trigger\nconst entrada = ($json.chatInput || '').toLowerCase().trim();\n\n// Lista de termos/gatilhos válidos para solicitar uma curiosidade\nconst termosValidos = [\n  'curiosidade',\n  'fato',\n  'pode falar',\n  'claro',\n  'diga',\n  'diga ai',\n  'me conte',\n  'me fala',\n  'manda',\n  'outra',\n  'mais um',\n  'aleatorio',\n  'conhecimento',\n  'sim',\n  'uma boa',\n  'info'\n];\n\n// Verifica se a mensagem contém pelo menos UM dos termos válidos\nconst eValido = termosValidos.some(termo => entrada.includes(termo));\n\nreturn [{\n  json: {\n    textoOriginal: $json.chatInput,\n    eValido: eValido\n  }\n}];"
      },
